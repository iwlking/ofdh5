{
  "name": "ofdh5",
  "version": "1.0.0",
  "description": "OFD (GB/T 33190-2016) preview for mobile web: pure-frontend canvas renderer with pdfh5-compatible API",
  "main": "./dist/ofdh5.umd.js",
  "module": "./dist/ofdh5.esm.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/ofdh5.min.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.standalone.config.mts && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "keywords": [
    "ofd",
    "ofd.js",
    "ofd-viewer",
    "ofd-preview",
    "电子发票",
    "版式文档",
    "canvas",
    "h5",
    "mobile",
    "pdfh5",
    "document"
  ],
  "license": "MIT",
  "author": {
    "name": "iwlking",
    "url": "https://github.com/iwlking"
  },
  "engines": {
    "node": ">=16"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iwlking/ofdh5.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/iwlking/ofdh5#readme",
  "bugs": {
    "url": "https://github.com/iwlking/ofdh5/issues"
  }
}
